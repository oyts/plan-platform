{
  "name": "plan-platform-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:desktop": "vite --config vite.config.ts --host 127.0.0.1 --mode desktop",
    "build:desktop-web": "vue-tsc -b && vite build --config vite.config.ts --mode desktop --outDir dist-desktop",
    "build:android-web": "vue-tsc -b && vite build --config vite.config.ts --mode android --outDir dist-android",
    "android:sync": "cap sync android",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/api": "^2.12.1",
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.17.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
