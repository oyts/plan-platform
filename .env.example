DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:43127
REGISTRATION_ENABLED=false
REFRESH_COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
MAX_SESSIONS=5
INVITATION_ENABLED=true
INVITATION_HOURS=168
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN_HASH=
BOOTSTRAP_ADMIN_EXPIRES_AT=
PLAN_VERSION=0.1.7
PLAN_PORT=43140
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_MINUTES=60
APP_PUBLIC_URL=https://plan.example.com
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AI_ENABLED=false
AI_MODEL=deepseek-flash
# Container path only; never put the key value in Git or a VITE_* variable.
AI_API_KEY_FILE=
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONCURRENT=2
AI_QUEUE_CAPACITY=4
AI_TIMEOUT_SECONDS=60
